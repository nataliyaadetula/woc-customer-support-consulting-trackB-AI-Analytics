              <flipboard active-id='3' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Sales are concentrated in North America, Europe, and Asia, with larger sales volumes generally shown by larger bubbles. Profitability varies across regions, suggesting that high sales do not always result in high profit.' captured-sheet='Global Sales' id='1'>
                    <capturedDeltas>
                      <worksheet name='Global Sales'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.1peasvh0l9zcpn142f6fm0sf4tt1].[Latitude (generated)]' field-type='quantitative' max='23120469.68294568' min='-23180274.238282301' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
