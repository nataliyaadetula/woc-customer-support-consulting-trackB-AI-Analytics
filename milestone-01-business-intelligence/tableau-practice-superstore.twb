                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='This visualization compares total sales across Furniture, Office Supplies, and Technology sub-categories. Bar height represents sales, while color indicates profit, making it easy to identify high-selling products and areas with lower or negative profitability.' captured-sheet='Sales Quantity by Market' id='2' />
                  <story-point caption='This visualization compares product quantities across Consumer, Corporate, and Home Office segments in different global markets. It shows how demand for Furniture, Office Supplies, and Technology varies by market and customer segment.' captured-sheet='Sales by Category' id='3' />
                </story-points>
              </flipboard>
